{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],

    "strict": true,
    "skipLibCheck": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noEmit": false
  }
}